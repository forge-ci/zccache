include Cargo.toml Cargo.lock rust-toolchain.toml README.md LICENSE setup.py
include .cargo/config.toml
recursive-include crates Cargo.toml README.md *.rs *.proto *.json
recursive-include python/zccache *.py py.typed
recursive-include ci *.py *.json
prune crates/*/tests
prune crates/*/benches
prune crates/*/python
prune ci/tests
prune python/tests
prune target
prune dist
prune perf
prune bench
prune docs
prune _vender
prune .git
global-exclude __pycache__ *.pyc *.so *.pyd *.dll *.dylib *.pdb *.png *.jpg *.jpeg *.gif
